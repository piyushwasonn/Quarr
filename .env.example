# Postgres (Neon in production)
DATABASE_URL="postgresql://quarr:quarr@localhost:5432/quarr"

# Public base URL used in emails and report links
APP_URL="http://localhost:3000"

# Bench (your review backend). Long random values in production.
BENCH_PASSWORD="change-me"
SESSION_SECRET="a-long-random-string-at-least-32-chars"

# AI wording layer. Without a key, findings use QUARR's own templates.
ANTHROPIC_API_KEY=""

# Email delivery via Resend. Without a key, emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="QUARR <firstlook@quarr.in>"

# Where screenshots are stored (local disk for now)
STORAGE_DIR="./storage"

# Only needed when the system Chromium differs from playwright-core's bundled one
CHROMIUM_PATH=""

# Crawl budget
CRAWL_TIMEOUT_MS="240000"

# Founder sign-in with Google (Google Cloud console → OAuth client, type "Web").
# Authorised redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments (Razorpay dashboard → API keys; Webhooks → payment.captured + order.paid → <APP_URL>/api/pay/webhook)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Set GST_RATE="0" if QUARR is not GST-registered.
GST_RATE="0.18"
PRICE_JOURNEY_PAISE="500000"
PRICE_RECHECK_PAISE="49900"
# Local testing only: simulate payments when no Razorpay keys are set.
PAYMENTS_DEV=""
# Gets an email when a journey is paid.
ADMIN_EMAIL=""

# Shown on /contact (Razorpay activation needs real contact details). Leave blank to hide a line.
CONTACT_EMAIL=""
CONTACT_PHONE=""
BUSINESS_NAME=""
BUSINESS_ADDRESS=""

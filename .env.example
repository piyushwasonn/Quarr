# Postgres (Neon in production)
DATABASE_URL="postgresql://quarr:quarr@localhost:5432/quarr"

# Public base URL used in emails and report links
APP_URL="http://localhost:3000"

# Bench (your review backend). Long random values in production.
BENCH_PASSWORD="change-me"
SESSION_SECRET="a-long-random-string-at-least-32-chars"

# AI wording layer. Without a key, findings use QUARR's own templates.
ANTHROPIC_API_KEY=""

# Email. Gmail: an account with 2-Step Verification and an app password.
SMTP_USER=""                 # e.g. quarr.firstlook@gmail.com
SMTP_PASS=""                 # the 16-character app password, not the Gmail password
# Later, with your own domain, Resend takes over automatically when this is set.
RESEND_API_KEY=""
EMAIL_FROM="QUARR <firstlook@quarr.in>"

# Where screenshots are stored: local disk in development, Netlify Blobs in production.
STORAGE_DRIVER=""            # "netlify" in production
STORAGE_DIR="./storage"
# GitHub Actions only: lets the crawler write to the site's Blobs from outside Netlify.
BLOBS_SITE_ID=""             # Netlify site → Site configuration → Project ID
BLOBS_TOKEN=""               # Netlify → User settings → Applications → Personal access token

# Netlify only: wakes the crawler workflow when a run is queued.
GITHUB_DISPATCH_TOKEN=""     # fine-grained token, this repo only, Contents: read and write
GITHUB_CRAWLER_REPO="piyushwasonn/quarr"

# Only needed when the system Chromium differs from playwright-core's bundled one
CHROMIUM_PATH=""

# Crawl budget
CRAWL_TIMEOUT_MS="240000"

# Founder sign-in with Google (Google Cloud console → OAuth client, type "Web").
# Authorised redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments (Razorpay dashboard → API keys; Webhooks → payment.captured + order.paid → <APP_URL>/api/pay/webhook)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Set GST_RATE="0" if QUARR is not GST-registered.
GST_RATE="0.18"
PRICE_JOURNEY_PAISE="500000"
PRICE_RECHECK_PAISE="49900"
# Local testing only: simulate payments when no Razorpay keys are set.
PAYMENTS_DEV=""
# Gets an email when a journey is paid.
ADMIN_EMAIL=""

# Shown on /contact (Razorpay activation needs real contact details). Leave blank to hide a line.
CONTACT_EMAIL=""
CONTACT_PHONE=""
BUSINESS_NAME=""
BUSINESS_ADDRESS=""

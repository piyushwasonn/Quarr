// QUARR — First Look data model.
// A Run is one store walk. It owns the captured Pages (evidence), the
// CheckResults (deterministic verdicts), and the Findings (what a founder reads).

generator client {
  provider      = "prisma-client-js"
  // native for local and GitHub Actions; rhel-openssl-3.0.x for Netlify Functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunStatus {
  QUEUED
  CRAWLING
  CRAWLED
  CHECKED
  DRAFTED
  IN_REVIEW
  APPROVED
  PUBLISHED
  DELIVERED
  READY // automated result with no review step (preview, re-check)
  CRAWL_FAILED
  REJECTED
}

enum RunKind {
  PREVIEW // quick anonymous walk on the landing page
  FULL // the First Look, reviewed in the Bench
  RECHECK // paid re-walk compared with an earlier run
}

enum RunSource {
  PUBLIC // a founder submitted their own store
  BENCH // you queued it yourself (outreach)
}

enum Outcome {
  PASS
  FAIL
  NOT_OBSERVABLE
}

enum FindingState {
  DRAFT
  APPROVED
  EDITED
  DROPPED
}

enum EditReason {
  WORDING
  SEVERITY
  EVIDENCE_WRONG
  FALSE_POSITIVE
  MISSED
  UNSAFE
}

model Run {
  id             String    @id @default(cuid())
  publicToken    String    @unique
  storeUrl       String
  domain         String
  email          String?
  kind           RunKind   @default(FULL)
  priority       Int       @default(5) // lower runs first
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentRunId    String? // RECHECK: the run being compared; FULL: the preview it came from
  progress       String? // what the crawler is doing right now, for the live screen
  summary        Json? // preview teaser / instant findings / re-check comparison
  source         RunSource @default(PUBLIC)
  status         RunStatus @default(QUEUED)
  failureCode    String? // BLOCKED | PASSWORD | NOT_STORE | UNREACHABLE | TIMEOUT | ERROR
  failureDetail  String?
  platform       String? // shopify | woocommerce | unknown
  storeName      String?
  ipHash         String?
  attempts       Int       @default(0)
  lockedAt       DateTime?
  autoPublished  Boolean   @default(false)
  reviewStartAt  DateTime?
  reviewSeconds  Int?
  otherIssues    Int       @default(0)
  otherLenses    Int       @default(0)
  checksPassed   Int       @default(0)
  checksNotSeen  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  crawledAt      DateTime?
  publishedAt    DateTime?
  deliveredAt    DateTime?
  repliedAt      DateTime?
  paidAt         DateTime?
  notes          String?
  ai             Json? // AiReport (engine/ai/analyse.ts): what QUARR's AI did on this run

  pages    Page[]
  results  CheckResult[]
  findings  Finding[]
  events    ReviewEvent[]
  learnings Learning[]

  @@index([domain, createdAt])
  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Page {
  id               String   @id @default(cuid())
  runId            String
  run              Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind             String // HOME | PRODUCT_1 | PRODUCT_2 | CART | CHECKOUT | SHIPPING | RETURNS | TERMS | PRIVACY | CONTACT | ABOUT
  url              String
  finalUrl         String?
  httpStatus       Int?
  title            String?
  text             String   @db.Text
  mobileShot       String?
  desktopShot      String?
  mobileHeight     Int?
  desktopHeight    Int?
  data             Json // headings, links, jsonLd, metrics, element boxes
  createdAt        DateTime @default(now())

  @@index([runId])
}

model CheckResult {
  id               String   @id @default(cuid())
  runId            String
  run              Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  checkId          String
  lens             String
  outcome          Outcome
  severity         Int
  evidenceStrength Float
  citation         Json?
  detail           Json?
  ai               Json? // AiVerdict (engine/ai/verify.ts): the AI's second reading of a FAIL
  createdAt        DateTime @default(now())
  finding          Finding?

  @@index([runId])
  @@index([checkId, createdAt])
}

model Finding {
  id            String       @id @default(cuid())
  runId         String
  run           Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  checkResultId String       @unique
  checkResult   CheckResult  @relation(fields: [checkResultId], references: [id], onDelete: Cascade)
  checkId       String
  lens          String
  score         Float
  selected      Boolean      @default(false)
  position      Int?
  title         String
  observed      String       @db.Text
  likelyEffect  String       @db.Text
  notYetProven  String       @db.Text
  draftedBy     String // claude | openai | template
  whatToDo      String? // the founder's next step (engine/checks/fixes.ts), editable on the Bench
  original      Json? // the draft as written, before any edit
  state         FindingState @default(DRAFT)
  editReason    EditReason?
  editNote      String?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([runId])
  @@index([checkId, reviewedAt])
}

// What a reviewer noticed that QUARR didn't: a missed issue (a candidate new check) or a note.
// Everything else on Bench → Learnings is worked out from runs, results and decisions.
model Learning {
  id        String   @id @default(cuid())
  runId     String?
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind      String // MISSED | NOTE
  lens      String? // framework lens id (engine/framework/lenses.ts)
  note      String
  status    String   @default("OPEN") // OPEN | BUILT (became a check) | DISMISSED
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Every Bench decision, kept forever. This is what trains the engine.
model ReviewEvent {
  id        String      @id @default(cuid())
  runId     String
  run       Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  findingId String?
  checkId   String
  action    String // APPROVE | EDIT | DROP | PROMOTE | DEMOTE
  reason    EditReason?
  note      String?
  createdAt DateTime    @default(now())

  @@index([checkId, createdAt])
}

model CheckSetting {
  checkId   String   @id
  suspended Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt
}

model RemovalRequest {
  id        String    @id @default(cuid())
  domain    String
  email     String
  note      String?
  createdAt DateTime  @default(now())
  handledAt DateTime?
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  name       String?
  googleSub  String?    @unique
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime?
  runs       Run[]
  purchases  Purchase[]
}

model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

enum Product {
  JOURNEY
  RECHECK
}

enum PurchaseStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model Purchase {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product
  runId           String? // the First Look it was bought from
  domain          String?
  amountPaise     Int // what the buyer pays, GST included
  basePaise       Int
  gstPaise        Int
  status          PurchaseStatus @default(CREATED)
  provider        String // razorpay | dev
  providerOrderId String?        @unique
  paymentId       String?
  fulfilledAt     DateTime? // journey delivered
  note            String?
  createdAt       DateTime       @default(now())
  paidAt          DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
